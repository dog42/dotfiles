#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

prompt() {
  echo -e "\n$RED>>>$NC $*"
}

# Keyboard UK-DE
prompt "symlink kb-layout 'gb_umlauts'"
sudo ln -s $HOME/.config/xkb/gb_umlauts /usr/share/X11/xkb/symbols/gb_umlauts
sudo ln -s $HOME/.config/xkb/us_umlauts /usr/share/X11/xkb/symbols/us_umlauts

# IWD standalone (WLAN unabhängig von NetworkManager)
prompt "set up standalone iwd"
sudo pacman -S --noconfirm --needed linux-firmware iwd impala
sudo systemctl disable wpa_supplicant

# 1. Alte NM-Backend-Konfigurationen entfernen
sudo rm -f /etc/NetworkManager/conf.d/wifi_backend.conf /etc/NetworkManager/conf.d/iwd.conf

# 2. NetworkManager anweisen, WLAN-Geräte komplett zu ignorieren
sudo mkdir -p /etc/NetworkManager/conf.d
echo -e "[keyfile]\nunmanaged-devices=type:wifi" | sudo tee /etc/NetworkManager/conf.d/99-unmanaged-wifi.conf

# 3. iwd für eigenständiges DHCP & DNS (via systemd-resolved) konfigurieren
sudo mkdir -p /etc/iwd
sudo rm -rf /etc/systemd/system/iwd.service.d
sudo tee /etc/iwd/main.conf << 'EOF'
[General]
EnableNetworkConfiguration=true

[Network]
NameResolvingService=systemd
EOF

# 4. Dienste aktivieren und neu starten
sudo systemctl daemon-reload
sudo systemctl enable --now iwd
sudo systemctl restart NetworkManager iwd

# install platformio
prompt "install platformio"

curl -fsSL -o get-platformio.py https://raw.githubusercontent.com/platformio/platformio-core-installer/master/get-platformio.py
python3 get-platformio.py

mkdir -p /usr/local/bin
sudo ln -s ~/.platformio/penv/bin/platformio /usr/local/bin/platformio
sudo ln -s ~/.platformio/penv/bin/pio /usr/local/bin/pio
sudo ln -s ~/.platformio/penv/bin/piodebuggdb /usr/local/bin/piodebuggdb

# install tailscale wg-mesh-vpn
prompt "install tailscale"
curl -fsSL https://tailscale.com/install.sh | sh

