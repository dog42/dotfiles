#!/bin/bash

# Get remote tag
latest_tag=$(git -C "/home/$USER/.local/share/chezmoi" ls-remote origin main | grep -v "{}" | awk '{print $1}' | sed 's#refs/heads/main##')
if [[ -z $latest_tag ]]; then
  echo "Error: Could not retrieve latest tag."
  exit 1
fi

# Get local tag
current_tag=$(git -C "/home/$USER/.local/share/chezmoi" rev-parse HEAD)
if [[ -z $current_tag ]]; then
  echo "Error: Could not retrieve current tag."
  exit 1
fi

if [[ $current_tag != $latest_tag ]]; then
  echo "chezmoi update available ($latest_tag)"
  exit 0
else
  echo "chezmoi is up to date ($current_tag)"
  exit 1
fi
