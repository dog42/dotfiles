#!/usr/bin/env python3
"""
waybar-group-tabs: Touch-friendly Hyprland group tab manager for Waybar.
Supports:
  - Single and multiple window groups per workspace (e.g. split left/right)
  - Dropdown menu with grouped sections and reliable tab switching
  - Event-driven live updates via Hyprland socket2
"""

import sys
import os
import json
import re
import subprocess
import shutil
import time

def run_cmd(cmd):
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, check=True)
        return res.stdout.strip()
    except Exception:
        return ""

def get_current_workspace_id():
    output_name = os.environ.get("WAYBAR_OUTPUT_NAME")
    monitors_str = run_cmd(["hyprctl", "monitors", "-j"])
    if monitors_str:
        try:
            monitors = json.loads(monitors_str)
            if isinstance(monitors, list):
                if output_name:
                    for m in monitors:
                        if m.get("name") == output_name:
                            return m.get("activeWorkspace", {}).get("id")
                for m in monitors:
                    if m.get("focused"):
                        return m.get("activeWorkspace", {}).get("id")
                if monitors:
                    return monitors[0].get("activeWorkspace", {}).get("id")
        except Exception:
            pass

    ws_str = run_cmd(["hyprctl", "activeworkspace", "-j"])
    if ws_str:
        try:
            ws = json.loads(ws_str)
            return ws.get("id")
        except Exception:
            pass
    return None

def clean_title(title, win_class=""):
    if not title:
        return win_class or "Fenster"
    if "/" in title:
        title = os.path.basename(title)
    for suffix in [
        " — Mozilla Firefox",
        " - Google Chrome",
        " - Chromium",
        " — Zen Browser",
        " - Vivaldi",
    ]:
        if title.endswith(suffix):
            title = title[:-len(suffix)]
    return title.strip() or (win_class or "Fenster")

def get_icon_for_class(win_class):
    c = win_class.lower()
    if "zathura" in c or "pdf" in c:
        return "󰈦"
    elif "kitty" in c or "terminal" in c or "foot" in c or "alacritty" in c:
        return "󰞷"
    elif "firefox" in c or "zen" in c or "chrome" in c or "chromium" in c or "browser" in c:
        return "󰈹"
    elif "nvim" in c or "vim" in c or "code" in c:
        return "󰅩"
    elif "thunar" in c or "yazi" in c or "nautilus" in c:
        return "󰉋"
    return "󰓩"

def get_steps(current_idx, target_idx, total):
    if current_idx == target_idx or total <= 1:
        return []
    forward_steps = (target_idx - current_idx) % total
    backward_steps = (current_idx - target_idx) % total
    if forward_steps <= backward_steps:
        return ["f"] * forward_steps
    else:
        return ["b"] * backward_steps

def get_workspace_groups(current_ws_id):
    if current_ws_id is None:
        return [], None, {}

    active_str = run_cmd(["hyprctl", "activewindow", "-j"])
    active_addr = None
    if active_str:
        try:
            active_data = json.loads(active_str)
            if active_data.get("workspace", {}).get("id") == current_ws_id:
                active_addr = active_data.get("address")
        except Exception:
            pass

    clients_str = run_cmd(["hyprctl", "clients", "-j"])
    clients_by_addr = {}
    ws_clients = []
    if clients_str:
        try:
            for c in json.loads(clients_str):
                addr = c.get("address")
                if addr:
                    clients_by_addr[addr] = c
                if c.get("workspace", {}).get("id") == current_ws_id:
                    ws_clients.append(c)
        except Exception:
            pass

    # Find distinct groups on this workspace
    groups = []
    seen = set()
    for c in ws_clients:
        grouped = c.get("grouped", [])
        if isinstance(grouped, list) and len(grouped) >= 2:
            sort_key = tuple(sorted(grouped))
            if sort_key not in seen:
                seen.add(sort_key)

                # Determine active window in this group
                active_win = None
                if active_addr in grouped:
                    active_win = active_addr
                else:
                    for a in grouped:
                        cl = clients_by_addr.get(a, {})
                        if not cl.get("hidden", False):
                            active_win = a
                            break
                    if not active_win and grouped:
                        active_win = grouped[0]

                tab_idx = grouped.index(active_win) + 1 if active_win in grouped else 1
                is_focused = (active_addr in grouped)

                # Find min x coordinate for spatial sorting (left-to-right)
                min_x = 0
                for a in grouped:
                    cl = clients_by_addr.get(a, {})
                    at = cl.get("at", [0, 0])
                    if isinstance(at, list) and len(at) > 0:
                        min_x = at[0]
                        break

                groups.append({
                    "grouped": grouped,
                    "active_addr": active_win,
                    "active_tab_idx": tab_idx,
                    "is_focused": is_focused,
                    "total": len(grouped),
                    "pos_x": min_x
                })

    # Sort groups from left to right based on window position
    groups.sort(key=lambda g: g["pos_x"])

    return groups, active_addr, clients_by_addr

def get_status_json():
    current_ws = get_current_workspace_id()
    groups, active_addr, clients = get_workspace_groups(current_ws)

    if not groups:
        return json.dumps({"text": "", "alt": "empty", "class": "empty"})

    group_count = len(groups)
    if group_count == 1:
        g = groups[0]
        text = f"󰓩 {g['active_tab_idx']}/{g['total']}"
    else:
        parts = []
        for g in groups:
            if g["is_focused"]:
                parts.append(f"[{g['active_tab_idx']}/{g['total']}]")
            else:
                parts.append(f"{g['active_tab_idx']}/{g['total']}")
        text = "󰓩 " + " │ ".join(parts)

    tooltip_lines = []
    if group_count == 1:
        g = groups[0]
        tooltip_lines.append(f"<b>󰓩 Fenster-Gruppe ({g['total']} Tabs)</b>")
        tooltip_lines.append("────────────────────────────")
        for i, addr in enumerate(g["grouped"], 1):
            c = clients.get(addr, {})
            t = clean_title(c.get("title", ""), c.get("class", ""))
            cls = c.get("class", "")
            icon = get_icon_for_class(cls)
            if addr == g["active_addr"]:
                tooltip_lines.append(f"• <b>Tab {i}:</b> {icon} {t} <i>(aktiv)</i>")
            else:
                tooltip_lines.append(f"• <b>Tab {i}:</b> {icon} {t}")
    else:
        tooltip_lines.append(f"<b>󰓩 Workspace (Mehrere Gruppen)</b>")
        tooltip_lines.append("────────────────────────────")
        for g_idx, g in enumerate(groups, 1):
            focus_tag = " <i>(im Fokus)</i>" if g["is_focused"] else ""
            tooltip_lines.append(f"\n<b>Gruppe {g_idx} ({g['total']} Tabs){focus_tag}</b>")
            for i, addr in enumerate(g["grouped"], 1):
                c = clients.get(addr, {})
                t = clean_title(c.get("title", ""), c.get("class", ""))
                cls = c.get("class", "")
                icon = get_icon_for_class(cls)
                if addr == g["active_addr"]:
                    tooltip_lines.append(f"• <b>Tab {i}:</b> {icon} {t} <i>(aktiv)</i>")
                else:
                    tooltip_lines.append(f"• <b>Tab {i}:</b> {icon} {t}")

    tooltip_lines.append("\n<i>👆 Tippen: Dropdown-Menü öffnen</i>")
    tooltip_lines.append("<i>🔄 Scrollen: Tab wechseln</i>")

    out = {
        "text": text,
        "alt": "grouped",
        "tooltip": "\n".join(tooltip_lines).strip(),
        "class": "grouped"
    }
    return json.dumps(out)

def cmd_status():
    print(get_status_json())
    sys.stdout.flush()

def cmd_listen():
    print(get_status_json())
    sys.stdout.flush()

    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    xdg_runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sock_path = f"{xdg_runtime}/hypr/{signature}/.socket2.sock" if signature else ""

    if not sock_path or not os.path.exists(sock_path):
        last_out = None
        while True:
            cur = get_status_json()
            if cur != last_out:
                print(cur)
                sys.stdout.flush()
                last_out = cur
            time.sleep(1)

    import socket
    while True:
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(sock_path)
            last_out = None
            buf = ""
            while True:
                data = s.recv(4096)
                if not data:
                    break
                buf += data.decode("utf-8", errors="ignore")
                lines = buf.split("\n")
                buf = lines[-1]
                events = lines[:-1]

                relevant = False
                for ev in events:
                    if any(ev.startswith(p) for p in (
                        "workspace>>", "workspacev2>>", "activewindow>>",
                        "focusedmon>>", "openwindow>>", "closewindow>>",
                        "movewindow>>", "changegroupactive>>", "urgent>>"
                    )):
                        relevant = True
                        break

                if relevant:
                    cur = get_status_json()
                    if cur != last_out:
                        print(cur)
                        sys.stdout.flush()
                        last_out = cur
        except Exception:
            time.sleep(1)
            print(get_status_json())
            sys.stdout.flush()

def cmd_menu():
    try:
        res = subprocess.run(["pgrep", "-x", "wofi"], stdout=subprocess.DEVNULL)
        if res.returncode == 0:
            subprocess.run(["pkill", "-x", "wofi"])
            return
    except Exception:
        pass

    current_ws = get_current_workspace_id()
    groups, active_addr, clients = get_workspace_groups(current_ws)
    if not groups:
        return

    menu_lines = []
    entry_map = {}
    entry_num = 1
    multiple_groups = len(groups) > 1

    for g_idx, g in enumerate(groups, 1):
        if multiple_groups:
            focus_str = " (im Fokus)" if g["is_focused"] else ""
            menu_lines.append(f"── Gruppe {g_idx} ({g['total']} Tabs){focus_str} ──")

        for local_tab_idx, addr in enumerate(g["grouped"], 1):
            c = clients.get(addr, {})
            t = clean_title(c.get("title", ""), c.get("class", ""))
            cls = c.get("class", "")
            icon = get_icon_for_class(cls)
            active_mark = "  ●" if addr == g["active_addr"] else ""

            menu_lines.append(f"{entry_num}. {icon}  {t}{active_mark}")
            entry_map[entry_num] = {
                "target_addr": addr,
                "target_tab_idx": local_tab_idx,
                "visible_addr": g["active_addr"],
                "current_tab_idx": g["active_tab_idx"],
                "total": g["total"]
            }
            entry_num += 1

    menu_input = "\n".join(menu_lines) + "\n"
    selected = None

    launcher = os.environ.get("WAYBAR_GROUP_TABS_MENU", "wofi")
    config_dir = os.path.expanduser("~/.config/waybar")
    wofi_conf = os.path.join(config_dir, "wofi-tabs.conf")
    wofi_css = os.path.join(config_dir, "wofi-tabs.css")

    total_selectable_lines = len(menu_lines)

    if launcher == "wofi" and shutil.which("wofi"):
        cmd = ["wofi", "--dmenu", "--prompt", "Tabs:"]
        if os.path.exists(wofi_conf):
            cmd.extend(["--conf", wofi_conf])
        if os.path.exists(wofi_css):
            cmd.extend(["--style", wofi_css])
        cmd.extend(["--lines", str(min(15, total_selectable_lines))])

        try:
            proc = subprocess.run(cmd, input=menu_input, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            if proc.returncode == 0 and proc.stdout.strip():
                selected = proc.stdout.strip()
        except Exception:
            selected = None
    elif shutil.which("walker"):
        cmd = ["walker", "--dmenu", "-n", "-p", "Tabs:"]
        try:
            proc = subprocess.run(cmd, input=menu_input, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            if proc.returncode == 0 and proc.stdout.strip():
                selected = proc.stdout.strip()
        except Exception:
            selected = None

    if selected:
        m = re.match(r"^(\d+)\.", selected)
        if m:
            chosen_num = int(m.group(1))
            entry = entry_map.get(chosen_num)
            if entry:
                target_addr = entry["target_addr"]
                target_tab_idx = entry["target_tab_idx"]
                visible_addr = entry["visible_addr"]
                current_tab_idx = entry["current_tab_idx"]
                total = entry["total"]

                # Step 1: Focus the target group container by focusing its visible window
                if visible_addr:
                    subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{visible_addr}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    subprocess.run(["hyprctl", "eval", f"hl.focus({{ window = 'address:{visible_addr}' }})"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

                # Step 2: Set the active tab in this group via Lua setGroupActive
                subprocess.run(["hyprctl", "eval", f"hl.group.active({{ index = {target_tab_idx} }})"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.run(["hyprctl", "eval", f"hl.group.active({{ index = {target_tab_idx}, window = 'address:{target_addr}' }})"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

                # Step 3: Cycle forward/backward steps if needed as a guarantee
                steps = get_steps(current_tab_idx, target_tab_idx, total)
                for step in steps:
                    subprocess.run(["hyprctl", "dispatch", "changegroupactive", step], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

                # Step 4: Final focus on the selected window
                subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{target_addr}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.run(["hyprctl", "eval", f"hl.focus({{ window = 'address:{target_addr}' }})"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def cmd_next():
    subprocess.run(["hyprctl", "dispatch", "changegroupactive", "f"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def cmd_prev():
    subprocess.run(["hyprctl", "dispatch", "changegroupactive", "b"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "listen"
    if arg == "listen":
        cmd_listen()
    elif arg == "status":
        cmd_status()
    elif arg == "menu":
        cmd_menu()
    elif arg in ("next", "f"):
        cmd_next()
    elif arg in ("prev", "b"):
        cmd_prev()
    else:
        print(f"Unknown command: {arg}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
