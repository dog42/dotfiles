#!/usr/bin/env python3
"""
waybar-group-tabs: Touch-friendly Hyprland group tab manager for Waybar.
Provides:
  - status: Single-shot JSON output for Waybar
  - listen: Event-driven continuous stream via Hyprland socket2 for instant updates
  - menu: Dropdown menu (via wofi or walker) to switch tabs with a single tap
  - next / prev: Cycle through group tabs
"""

import sys
import os
import json
import re
import subprocess
import shutil
import time

def run_cmd(cmd):
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, check=True)
        return res.stdout.strip()
    except Exception:
        return ""

def get_current_workspace_id():
    output_name = os.environ.get("WAYBAR_OUTPUT_NAME")
    monitors_str = run_cmd(["hyprctl", "monitors", "-j"])
    if monitors_str:
        try:
            monitors = json.loads(monitors_str)
            if isinstance(monitors, list):
                if output_name:
                    for m in monitors:
                        if m.get("name") == output_name:
                            return m.get("activeWorkspace", {}).get("id")
                for m in monitors:
                    if m.get("focused"):
                        return m.get("activeWorkspace", {}).get("id")
                if monitors:
                    return monitors[0].get("activeWorkspace", {}).get("id")
        except Exception:
            pass

    ws_str = run_cmd(["hyprctl", "activeworkspace", "-j"])
    if ws_str:
        try:
            ws = json.loads(ws_str)
            return ws.get("id")
        except Exception:
            pass
    return None

def get_group_for_workspace(current_ws_id):
    if current_ws_id is None:
        return None, None, {}

    active_str = run_cmd(["hyprctl", "activewindow", "-j"])
    active = None
    if active_str:
        try:
            active = json.loads(active_str)
        except Exception:
            active = None

    clients_str = run_cmd(["hyprctl", "clients", "-j"])
    clients_by_addr = {}
    workspace_clients = []
    if clients_str:
        try:
            clients_list = json.loads(clients_str)
            for c in clients_list:
                addr = c.get("address")
                if addr:
                    clients_by_addr[addr] = c
                if c.get("workspace", {}).get("id") == current_ws_id:
                    workspace_clients.append(c)
        except Exception:
            pass

    # Priority 1: Active window is on current workspace and is grouped
    if active:
        active_ws = active.get("workspace", {}).get("id")
        grouped = active.get("grouped", [])
        if active_ws == current_ws_id and isinstance(grouped, list) and len(grouped) >= 2:
            return active, grouped, clients_by_addr

    # Priority 2: Check if any window on current workspace has a group
    for c in workspace_clients:
        grouped = c.get("grouped", [])
        if isinstance(grouped, list) and len(grouped) >= 2:
            return c, grouped, clients_by_addr

    # No group on this workspace
    return None, None, clients_by_addr

def clean_title(title, win_class=""):
    if not title:
        return win_class or "Fenster"
    if "/" in title:
        title = os.path.basename(title)
    for suffix in [
        " — Mozilla Firefox",
        " - Google Chrome",
        " - Chromium",
        " — Zen Browser",
        " - Vivaldi",
    ]:
        if title.endswith(suffix):
            title = title[:-len(suffix)]
    return title.strip() or (win_class or "Fenster")

def get_icon_for_class(win_class):
    c = win_class.lower()
    if "zathura" in c or "pdf" in c:
        return "󰈦"
    elif "kitty" in c or "terminal" in c or "foot" in c or "alacritty" in c:
        return "󰞷"
    elif "firefox" in c or "zen" in c or "chrome" in c or "chromium" in c or "browser" in c:
        return "󰈹"
    elif "nvim" in c or "vim" in c or "code" in c:
        return "󰅩"
    elif "thunar" in c or "yazi" in c or "nautilus" in c:
        return "󰉋"
    return "󰓩"

def get_status_json():
    current_ws = get_current_workspace_id()
    active, grouped, clients = get_group_for_workspace(current_ws)

    if not active or not grouped or len(grouped) < 2:
        return json.dumps({"text": "", "alt": "empty", "class": "empty"})

    active_addr = active.get("address", "")
    total = len(grouped)
    try:
        idx = grouped.index(active_addr) + 1
    except ValueError:
        idx = 1

    active_client = clients.get(active_addr, active)
    curr_title = clean_title(active_client.get("title", ""), active_client.get("class", ""))
    max_title_len = 22
    short_title = curr_title[:max_title_len - 1] + "…" if len(curr_title) > max_title_len else curr_title

    text = f"󰓩 {idx}/{total} {short_title} ▾"

    tooltip_lines = [
        f"<b>󰓩 Fenster-Gruppe ({total} Tabs)</b>",
        "────────────────────────────"
    ]
    for i, addr in enumerate(grouped, 1):
        c = clients.get(addr, {})
        t = clean_title(c.get("title", ""), c.get("class", ""))
        cls = c.get("class", "")
        icon = get_icon_for_class(cls)
        if addr == active_addr:
            tooltip_lines.append(f"• <b>Tab {i}:</b> {icon} {t} <i>(aktiv)</i>")
        else:
            tooltip_lines.append(f"• <b>Tab {i}:</b> {icon} {t}")

    tooltip_lines.append("\n<i>👆 Tippen: Dropdown-Menü öffnen</i>")
    tooltip_lines.append("<i>🔄 Scrollen: Tab wechseln</i>")

    out = {
        "text": text,
        "alt": "grouped",
        "tooltip": "\n".join(tooltip_lines),
        "class": "grouped"
    }
    return json.dumps(out)

def cmd_status():
    print(get_status_json())
    sys.stdout.flush()

def cmd_listen():
    print(get_status_json())
    sys.stdout.flush()

    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    xdg_runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sock_path = f"{xdg_runtime}/hypr/{signature}/.socket2.sock" if signature else ""

    if not sock_path or not os.path.exists(sock_path):
        last_out = None
        while True:
            cur = get_status_json()
            if cur != last_out:
                print(cur)
                sys.stdout.flush()
                last_out = cur
            time.sleep(1)

    import socket
    while True:
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(sock_path)
            last_out = None
            buf = ""
            while True:
                data = s.recv(4096)
                if not data:
                    break
                buf += data.decode("utf-8", errors="ignore")
                lines = buf.split("\n")
                buf = lines[-1]
                events = lines[:-1]

                relevant = False
                for ev in events:
                    if any(ev.startswith(p) for p in (
                        "workspace>>", "workspacev2>>", "activewindow>>",
                        "focusedmon>>", "openwindow>>", "closewindow>>",
                        "movewindow>>", "changegroupactive>>", "urgent>>"
                    )):
                        relevant = True
                        break

                if relevant:
                    cur = get_status_json()
                    if cur != last_out:
                        print(cur)
                        sys.stdout.flush()
                        last_out = cur
        except Exception:
            time.sleep(1)
            print(get_status_json())
            sys.stdout.flush()

def cmd_menu():
    try:
        res = subprocess.run(["pgrep", "-x", "wofi"], stdout=subprocess.DEVNULL)
        if res.returncode == 0:
            subprocess.run(["pkill", "-x", "wofi"])
            return
    except Exception:
        pass

    current_ws = get_current_workspace_id()
    active, grouped, clients = get_group_for_workspace(current_ws)
    if not active or not grouped or len(grouped) < 2:
        return

    active_addr = active.get("address", "")
    lines = []
    addr_by_idx = {}

    for i, addr in enumerate(grouped, 1):
        c = clients.get(addr, {})
        t = clean_title(c.get("title", ""), c.get("class", ""))
        cls = c.get("class", "")
        icon = get_icon_for_class(cls)
        active_mark = "  ●" if addr == active_addr else ""
        entry = f"{i}. {icon}  {t}{active_mark}"
        lines.append(entry)
        addr_by_idx[i] = addr

    menu_input = "\n".join(lines) + "\n"
    selected = None

    launcher = os.environ.get("WAYBAR_GROUP_TABS_MENU", "wofi")
    config_dir = os.path.expanduser("~/.config/waybar")
    wofi_conf = os.path.join(config_dir, "wofi-tabs.conf")
    wofi_css = os.path.join(config_dir, "wofi-tabs.css")

    if launcher == "wofi" and shutil.which("wofi"):
        cmd = ["wofi", "--dmenu", "--prompt", "Tabs in Gruppe:"]
        if os.path.exists(wofi_conf):
            cmd.extend(["--conf", wofi_conf])
        if os.path.exists(wofi_css):
            cmd.extend(["--style", wofi_css])
        cmd.extend(["--lines", str(len(grouped))])

        try:
            proc = subprocess.run(cmd, input=menu_input, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            if proc.returncode == 0 and proc.stdout.strip():
                selected = proc.stdout.strip()
        except Exception:
            selected = None
    elif shutil.which("walker"):
        cmd = ["walker", "--dmenu", "-n", "-p", "Tabs in Gruppe:"]
        try:
            proc = subprocess.run(cmd, input=menu_input, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            if proc.returncode == 0 and proc.stdout.strip():
                selected = proc.stdout.strip()
        except Exception:
            selected = None

    if selected:
        m = re.match(r"^(\d+)\.", selected)
        if m:
            chosen_idx = int(m.group(1))
            target_addr = addr_by_idx.get(chosen_idx)
            if target_addr:
                subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{target_addr}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def cmd_next():
    subprocess.run(["hyprctl", "dispatch", "changegroupactive", "f"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def cmd_prev():
    subprocess.run(["hyprctl", "dispatch", "changegroupactive", "b"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "listen"
    if arg == "listen":
        cmd_listen()
    elif arg == "status":
        cmd_status()
    elif arg == "menu":
        cmd_menu()
    elif arg in ("next", "f"):
        cmd_next()
    elif arg in ("prev", "b"):
        cmd_prev()
    else:
        print(f"Unknown command: {arg}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
