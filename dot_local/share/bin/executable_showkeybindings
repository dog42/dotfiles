#!/bin/bash

# Display keybindings for Hyprland, Neovim, Zathura and custom cheatsheets using walker.

declare -A KEYCODE_SYM_MAP

build_keymap_cache() {
  local keymap
  keymap="$(xkbcli compile-keymap 2>/dev/null)" || return 1

  while IFS=, read -r code sym; do
    [[ -z "$code" || -z "$sym" ]] && continue
    KEYCODE_SYM_MAP["$code"]="$sym"
  done < <(
    awk '
      BEGIN { sec = "" }
      /xkb_keycodes/ { sec = "codes"; next }
      /xkb_symbols/  { sec = "syms";  next }
      sec == "codes" {
        if (match($0, /<([A-Za-z0-9_]+)>\s*=\s*([0-9]+)\s*;/, m)) code_by_name[m[1]] = m[2]
      }
      sec == "syms" {
        if (match($0, /key\s*<([A-Za-z0-9_]+)>\s*\{\s*\[\s*([^, \]]+)/, m)) sym_by_name[m[1]] = m[2]
      }
      END {
        for (k in code_by_name) {
          c = code_by_name[k]
          s = sym_by_name[k]
          if (c != "" && s != "" && s != "NoSymbol") print c "," s
        }
      }
    ' <<<"$keymap"
  )
}

lookup_keycode_cached() {
  printf '%s\n' "${KEYCODE_SYM_MAP[$1]}"
}

parse_keycodes() {
  local start end elapsed
  [[ "${DEBUG:-0}" == "1" ]] && start=$(date +%s.%N)
  while IFS= read -r line; do
    if [[ "$line" =~ code:([0-9]+) ]]; then
      code="${BASH_REMATCH[1]}"
      symbol=$(lookup_keycode_cached "$code")
      echo "${line/code:${code}/$symbol}"
    elif [[ "$line" =~ mouse:([0-9]+) ]]; then
      code="${BASH_REMATCH[1]}"

      case "$code" in
      272) symbol="LEFT MOUSE BUTTON" ;;
      273) symbol="RIGHT MOUSE BUTTON" ;;
      274) symbol="MIDDLE MOUSE BUTTON" ;;
      *) symbol="mouse:${code}" ;;
      esac

      echo "${line/mouse:${code}/$symbol}"
    else
      echo "$line"
    fi
  done

  if [[ "$DEBUG" == "1" ]]; then
    end=$(date +%s.%N)
    if command -v bc >/dev/null 2>&1; then
      elapsed=$(echo "$end - $start" | bc)
    else
      elapsed=$(awk -v s="$start" -v e="$end" 'BEGIN{printf "%.6f", (e - s)}')
    fi
    echo "[DEBUG] parse_keycodes elapsed: ${elapsed}s" >&2
  fi
}

dynamic_bindings() {
  local binds
  binds=$(hyprctl -j binds 2>/dev/null) || return 0
  [[ -z "$binds" || "$binds" == "null" ]] && return 0

  echo "$binds" |
    jq -r '.[] | {modmask, key, keycode, description, dispatcher, arg} | "\(.modmask),\(.key)@\(.keycode),\(.description),\(.dispatcher),\(.arg)"' 2>/dev/null |
    sed -r \
      -e 's/null//' \
      -e 's,~/.local/share/omarchy/bin/,,' \
      -e 's,uwsm app -- ,,' \
      -e 's,uwsm-app -- ,,' \
      -e 's/@0//' \
      -e 's/,@/,code:/' \
      -e 's/^0,/,/' \
      -e 's/^1,/SHIFT,/' \
      -e 's/^4,/CTRL,/' \
      -e 's/^5,/SHIFT CTRL,/' \
      -e 's/^8,/ALT,/' \
      -e 's/^9,/SHIFT ALT,/' \
      -e 's/^12,/CTRL ALT,/' \
      -e 's/^13,/SHIFT CTRL ALT,/' \
      -e 's/^64,/SUPER,/' \
      -e 's/^65,/SUPER SHIFT,/' \
      -e 's/^68,/SUPER CTRL,/' \
      -e 's/^69,/SUPER SHIFT CTRL,/' \
      -e 's/^72,/SUPER ALT,/' \
      -e 's/^73,/SUPER SHIFT ALT,/' \
      -e 's/^76,/SUPER CTRL ALT,/' \
      -e 's/^77,/SUPER SHIFT CTRL ALT,/'
}

static_bindings() {
  echo "SHIFT ALT,L,Copy URL from Web App,extension,copy-url"
}

parse_bindings() {
  awk -F, '
{
    key_combo = $1 " + " $2;
    gsub(/^[ \t]*\+?[ \t]*/, "", key_combo);
    gsub(/[ \t]+$/, "", key_combo);

    action = $3;
    if (action == "") {
        for (i = 4; i <= NF; i++) {
            action = action $i (i < NF ? "," : "");
        }
        sub(/,$/, "", action);
        gsub(/(^|,)[[:space:]]*exec[[:space:]]*,?/, "", action);
        gsub(/^[ \t]+|[ \t]+$/, "", action);
        gsub(/[ \t]+/, " ", key_combo);

        gsub(/&/, "\\&amp;", action);
        gsub(/</, "\\&lt;", action);
        gsub(/>/, "\\&gt;", action);
        gsub(/"/, "\\&quot;", action);
        gsub(/'"'"'/, "\\&apos;", action);
    }

    if (action != "") {
        printf "[%-8s] %-26s → %s\n", "hypr", key_combo, action;
    }
}'
}

# Parse pipe-separated files and streams with \| escape support
parse_pipe_data() {
  awk -F'|' '
  {
    line = $0
    if (line ~ /^[[:space:]]*#/ || line ~ /^[[:space:]]*$/) next

    # Replace escaped \| with placeholder \x01
    gsub(/\\\|/, "\x01", line)
    n = split(line, arr, "|")
    if (n >= 3) {
      cat = arr[1]
      key = arr[2]
      desc = arr[3]
      for (i = 4; i <= n; i++) desc = desc "|" arr[i]

      # Restore escaped pipe
      gsub(/\x01/, "|", key)
      gsub(/\x01/, "|", desc)

      gsub(/^[[:space:]]+|[[:space:]]+$/, "", cat)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", desc)

      printf "[%-8s] %-26s → %s\n", cat, key, desc
    }
  }
  '
}

# Automatically parse user keymaps with desc from Neovim keymaps.lua
parse_nvim_user_keymaps() {
  local keymaps_file="$HOME/.config/nvim/lua/config/keymaps.lua"
  [[ -f "$keymaps_file" ]] || return 0

  python3 -c '
import re, sys

try:
    with open(sys.argv[1], "r", encoding="utf-8") as f:
        clean_lines = [l for l in f if not l.strip().startswith("--")]
    clean_content = "\n".join(clean_lines)

    pattern = r"vim\.keymap\.set\s*\(\s*(?:\{[^}]+\}|[\"\x27][^\"\x27]+[\"\x27])\s*,\s*[\"\x27]([^\"\x27]+)[\"\x27].*?desc\s*=\s*[\"\x27]([^\"\x27]+)[\"\x27]"
    for m in re.finditer(pattern, clean_content, re.DOTALL):
        key, desc = m.group(1), m.group(2)
        print(f"nvim (U)|{key}|{desc}")
except Exception:
    pass
' "$keymaps_file" 2>/dev/null | parse_pipe_data
}

# Automatically parse user keymaps with desc from Yazi keymap.toml
parse_yazi_user_keymaps() {
  local keymap_file="$HOME/.config/yazi/keymap.toml"
  [[ -f "$keymap_file" ]] || return 0

  python3 -c '
import tomllib, sys

try:
    with open(sys.argv[1], "rb") as f:
        data = tomllib.load(f)
    for section in ["mgr", "input", "select"]:
        for km in data.get(section, {}).get("prepend_keymap", []) + data.get(section, {}).get("keymap", []):
            on = km.get("on")
            desc = km.get("desc", "")
            if isinstance(on, list):
                on = " ".join(on)
            if on and desc:
                print(f"yazi (U)|{on}|{desc}")
except Exception:
    pass
' "$keymap_file" 2>/dev/null | parse_pipe_data
}

# Load static/curated files from ~/.config/cheatsheets/
parse_custom_cheatsheets() {
  local cs_dir="$HOME/.config/cheatsheets"
  local files=(
    "$cs_dir/nvim.txt"
    "$cs_dir/yazi.txt"
    "$cs_dir/cheatsheet.txt"
    "$cs_dir/zathura.txt"
  )

  for file in "${files[@]}"; do
    if [[ -f "$file" ]]; then
      cat "$file" | parse_pipe_data
    fi
  done
}

# Detect active window context (nvim, zathura, yazi, or default hyprland)
detect_context() {
  local win_class win_title
  if command -v hyprctl >/dev/null 2>&1; then
    win_class=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // empty' 2>/dev/null | tr '[:upper:]' '[:lower:]')
    win_title=$(hyprctl activewindow -j 2>/dev/null | jq -r '.title // empty' 2>/dev/null | tr '[:upper:]' '[:lower:]')
  fi

  if [[ "$win_class" =~ zathura ]]; then
    echo "zathura"
  elif [[ "$win_title" =~ (yazi) || "$win_class" =~ yazi ]]; then
    echo "yazi"
  elif [[ "$win_class" =~ nvim || "$win_title" =~ nvim || ("$win_class" =~ (kitty|alacritty|wezterm|ghostty) && "$win_title" =~ (nvim|vim)) ]]; then
    echo "nvim"
  else
    echo "hyprland"
  fi
}

prioritize_entries() {
  local ctx="$1"
  awk -v ctx="$ctx" '
  {
    line = $0
    prio = 50

    if (line ~ /^\[hypr/) {
      prio = 30
      if (match(line, /Terminal/)) prio = 0
      if (match(line, /Browser/) && !match(line, /Browser[[:space:]]*\(/)) prio = 1
      if (match(line, /File manager/))  prio = 2
      if (match(line, /Launch apps/))  prio = 3
      if (match(line, /Omarchy menu/))  prio = 4
      if (match(line, /System menu/))  prio = 5
      if (match(line, /Theme menu/))  prio = 6
      if (match(line, /Full screen/))  prio = 7
      if (match(line, /Full width/))  prio = 8
      if (match(line, /Close window/))  prio = 9
      if (match(line, /Close all windows/))  prio = 10
      if (match(line, /Lock system/))  prio = 11
      if (match(line, /Toggle window floating/))  prio = 12
      if (match(line, /Toggle window split/))  prio = 13
      if (match(line, /Pop window/))  prio = 14
      if (match(line, /Universal/))  prio = 15
      if (match(line, /Clipboard/))  prio = 16
      if (match(line, /Audio controls/))  prio = 17
      if (match(line, /Bluetooth controls/))  prio = 18
      if (match(line, /Wifi controls/))  prio = 19
      if (match(line, /Emoji picker/))  prio = 20
      if (match(line, /Color picker/))  prio = 21
      if (match(line, /Screenshot/))  prio = 22
      if (match(line, /Screenrecording/))  prio = 23
      if (match(line, /(Switch|Next|Former|Previous).*workspace/))  prio = 24
      if (match(line, /Move window to workspace/))  prio = 25
      if (match(line, /Move window silently to workspace/))  prio = 26
      if (match(line, /Swap window/))  prio = 27
      if (match(line, /Move window focus/))  prio = 28
      if (match(line, /Move window$/))  prio = 29
      if (match(line, /Resize window/))  prio = 30
      if (match(line, /Expand window/))  prio = 31
      if (match(line, /Shrink window/))  prio = 32
      if (match(line, /scratchpad/))  prio = 33
      if (match(line, /notification/))  prio = 34
      if (match(line, /Toggle window transparency/))  prio = 35
      if (match(line, /Toggle workspace gaps/))  prio = 36
      if (match(line, /Toggle nightlight/))  prio = 37
      if (match(line, /Toggle locking/))  prio = 38
      if (match(line, /group/))  prio = 40
      if (match(line, /Scroll active workspace/))  prio = 41
      if (match(line, /Cycle to/))  prio = 42
      if (match(line, /Reveal active/))  prio = 43
      if (match(line, /Apple Display/))  prio = 44
      if (match(line, /XF86/))  prio = 45

      if (ctx == "nvim" || ctx == "zathura" || ctx == "yazi") {
        prio += 50
      }
    } else if (line ~ /^\[nvim \(U\)/) {
      prio = (ctx == "nvim") ? 1 : 52
    } else if (line ~ /^\[yazi \(U\)/) {
      prio = (ctx == "yazi") ? 1 : 53
    } else if (line ~ /^\[VimTrick/) {
      prio = (ctx == "nvim") ? 2 : 54
    } else if (line ~ /^\[yazi/) {
      prio = (ctx == "yazi") ? 2 : 55
    } else if (line ~ /^\[nvim/) {
      prio = (ctx == "nvim") ? 3 : 56
    } else if (line ~ /^\[Zathura/) {
      prio = (ctx == "zathura") ? 1 : 60
    }

    printf "%03d\t%s\n", prio, line
  }' |
    sort -k1,1n -k2,2 |
    cut -f2-
}

all_bindings() {
  local context="$1"

  build_keymap_cache 2>/dev/null || true

  {
    # Hyprland bindings
    {
      dynamic_bindings
      static_bindings
    } |
      sort -u |
      parse_keycodes |
      parse_bindings

    # Custom, Neovim and Yazi bindings
    parse_nvim_user_keymaps
    parse_yazi_user_keymaps
    parse_custom_cheatsheets
  } |
    prioritize_entries "$context"
}

# CLI Argument parsing
MODE="walker"
FILTER=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--print)
      MODE="print"
      shift
      ;;
    --nvim)
      FILTER="nvim"
      shift
      ;;
    --yazi)
      FILTER="yazi"
      shift
      ;;
    --zathura)
      FILTER="Zathura"
      shift
      ;;
    --hypr|--hyprland)
      FILTER="hypr"
      shift
      ;;
    --cheats|--tricks)
      FILTER="VimTrick"
      shift
      ;;
    -h|--help)
      echo "Usage: showkeybindings [OPTIONS]"
      echo ""
      echo "Options:"
      echo "  -p, --print        Print keybindings in terminal"
      echo "  --nvim             Filter only nvim & VimTrick"
      echo "  --yazi             Filter only yazi"
      echo "  --zathura          Filter only zathura"
      echo "  --hypr             Filter only hypr"
      echo "  --cheats           Filter only personal VimTricks"
      echo "  -h, --help         Show this help message"
      exit 0
      ;;
    *)
      shift
      ;;
  esac
done

ACTIVE_CONTEXT=$(detect_context)

if [[ "$MODE" == "print" ]]; then
  if [[ -n "$FILTER" ]]; then
    all_bindings "$ACTIVE_CONTEXT" | grep -F "[$FILTER"
  else
    all_bindings "$ACTIVE_CONTEXT"
  fi
else
  monitor_height=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .height' 2>/dev/null)
  if [[ -z "$monitor_height" || "$monitor_height" -le 0 ]]; then
    monitor_height=1080
  fi
  menu_height=$((monitor_height * 45 / 100))

  if [[ -n "$FILTER" ]]; then
    all_bindings "$ACTIVE_CONTEXT" |
      grep -F "[$FILTER" |
      walker --dmenu -p 'Keybindings' --width 900 --height "$menu_height"
  else
    all_bindings "$ACTIVE_CONTEXT" |
      walker --dmenu -p 'Keybindings' --width 900 --height "$menu_height"
  fi
fi
