# Generated by chezmoi from .chezmoidata/theme-colors.toml
# Do not edit this file directly; edit .chezmoidata/theme-colors.toml instead.

# General settings
set window-title-basename true
set guioptions "s"
set selection-clipboard clipboard
set adjust-open "best-fit"
set pages-per-row 1
set scroll-step 50

# Recolor (Dark Mode) - disabled by default, toggle anytime with Ctrl+r
set recolor false
set recolor-keephue true
set recolor-lightcolor "{{ .colors.bg }}"
set recolor-darkcolor "{{ .colors.fg }}"

# Window & UI Colors
set default-bg "{{ .colors.bg }}"
set default-fg "{{ .colors.fg }}"
set statusbar-bg "{{ .colors.bg_surface }}"
set statusbar-fg "{{ .colors.fg }}"
set inputbar-bg "{{ .colors.bg_surface }}"
set inputbar-fg "{{ .colors.fg }}"

# Notifications
set notification-bg "{{ .colors.bg_surface }}"
set notification-fg "{{ .colors.fg }}"
set notification-error-bg "{{ .colors.error }}"
set notification-error-fg "{{ .colors.fg }}"
set notification-warning-bg "{{ .colors.warning }}"
set notification-warning-fg "{{ .colors.bg }}"

# Highlights & Search (Ember Red)
set highlight-color "rgba(204, 17, 17, 0.4)"
set highlight-active-color "rgba(229, 66, 40, 0.6)"

# Completion & Index Menus
set completion-bg "{{ .colors.bg_surface }}"
set completion-fg "{{ .colors.fg }}"
set completion-group-bg "{{ .colors.bg_alt }}"
set completion-group-fg "{{ .colors.fg_muted }}"
set completion-highlight-bg "{{ .colors.accent }}"
set completion-highlight-fg "{{ .colors.fg }}"
set index-bg "{{ .colors.bg_surface }}"
set index-fg "{{ .colors.fg }}"
set index-active-bg "{{ .colors.accent }}"
set index-active-fg "{{ .colors.fg }}"
