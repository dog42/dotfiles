# Generated by chezmoi from .chezmoidata/theme-colors.toml
# Do not edit this file directly; edit .chezmoidata/theme-colors.toml instead.

# Base terminal colors
background            {{ .colors.bg }}
foreground            {{ .colors.fg }}
selection_background   {{ .colors.bg_alt }}
selection_foreground   {{ .colors.fg }}

# Cursor & Links
cursor                {{ .colors.fg }}
cursor_text_color     {{ .colors.bg }}
url_color             {{ .colors.accent_glow }}

# Window border colors
active_border_color   {{ .colors.border_active }}
inactive_border_color {{ .colors.border_inactive }}

# Tab Bar styling
active_tab_foreground   {{ .colors.fg }}
active_tab_background   {{ .colors.accent }}
inactive_tab_foreground {{ .colors.fg_muted }}
inactive_tab_background {{ .colors.bg_surface }}
tab_bar_background      {{ .colors.bg }}

# 16-Color Terminal ANSI Palette
color0  {{ .colors.ansi.black }}          # Black (charcoal - background CLI elements)
color1  {{ .colors.ansi.red }}            # Red (dark ember red - errors, git dirty)
color2  {{ .colors.ansi.green }}          # Green (moss green - git clean)
color3  {{ .colors.ansi.yellow }}         # Yellow (amber - warnings, numbers)
color4  {{ .colors.ansi.blue }}           # Blue (warm ember red / scarlet - links in CLI tools)
color5  {{ .colors.ansi.magenta }}        # Magenta (muted ruby red - CLI symbols)
color6  {{ .colors.ansi.cyan }}           # Cyan (warm ember red / scarlet - paths & references)
color7  {{ .colors.ansi.white }}          # White (light ash gray - standard text)
color8  {{ .colors.ansi.bright_black }}   # Bright Black (graphite gray - dim/comments)
color9  {{ .colors.ansi.bright_red }}     # Bright Red (bright ember red - git ahead/behind)
color10 {{ .colors.ansi.bright_green }}   # Bright Green (spring green - git clean checkmark '✔')
color11 {{ .colors.ansi.bright_yellow }}  # Bright Yellow (bright amber - flags/parameters)
color12 {{ .colors.ansi.bright_blue }}    # Bright Blue (light scarlet - active links)
color13 {{ .colors.ansi.bright_magenta }} # Bright Magenta (coral red - matches/constants)
color14 {{ .colors.ansi.bright_cyan }}    # Bright Cyan (light scarlet - clickable URLs)
color15 {{ .colors.ansi.bright_white }}   # Bright White (pure white - bold text, git branch)
