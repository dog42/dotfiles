/* Wofi dropdown styling for Hyprland group tabs */
/* Generated by chezmoi from .chezmoidata/theme-colors.toml */

window {
    margin: 0px;
    background-color: {{ .colors.bg }};
    border: 2px solid {{ .colors.border_active }};
    border-radius: 10px;
    font-family: 'CaskaydiaMono Nerd Font', monospace;
    font-size: 13px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.7);
}

#outer-box {
    margin: 4px;
    padding: 2px;
    background-color: {{ .colors.bg }};
}

#inner-box {
    background-color: {{ .colors.bg }};
}

#entry {
    padding: 10px 14px;
    border-radius: 6px;
    color: {{ .colors.fg }};
    background-color: transparent;
    margin: 2px 0px;
}

#entry:selected {
    background-color: {{ .colors.bg_surface }};
    border-left: 4px solid {{ .colors.accent }};
    color: #ffffff;
    font-weight: bold;
}

#text {
    color: inherit;
}
