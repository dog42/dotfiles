# yazi
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd <"$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

# tailscale funnel + QR code
function tsqr() {
  local port="${1:-8080}"
  local tmp_file="/tmp/ts_output"
  clear
  # 1. Checks
  if ! systemctl is-active --quiet tailscaled; then
    echo -e "\033[31m[!] tailscaled is not running.\033[0m"
    # Bash-compatible read
    echo -n "Start service? (y/n): "
    read start_daemon
    [[ "$start_daemon" =~ ^[YyJj] ]] && sudo systemctl start tailscaled || return 1
  fi

  if ! tailscale status --peers=false >/dev/null 2>&1; then
    echo -e "\033[31m[!] Tailscale is offline.\033[0m"
    echo -n "Run 'tailscale up'? (y/n): "
    read do_up
    [[ "$do_up" =~ ^[YyJj] ]] && sudo tailscale up || return 1
  fi

  echo "[✔] Starting funnel on port $port..."

  # Universal bash subshell pattern:
  # Starts the process in a subshell and redirects output completely.
  # 'disown' after start prevents job notification on termination.
  sudo tailscale funnel "$port" >"$tmp_file" 2>&1 &
  local ts_pid=$!
  disown $ts_pid 2>/dev/null

  cleanup() {
    trap - INT
    # Suppress error message if process has already terminated
    sudo kill "$ts_pid" 2>/dev/null

    sleep 0.2
    rm -f "$tmp_file"
    clear
    echo -e "\033[32m[✔] Tunnel stopped\033[0m"
    echo -n "Disable Tailscale (tailscale down)? (y/n): "
    read do_down
    if [[ "$do_down" =~ ^[YyJj] ]]; then
      sudo tailscale down
      echo -e "\n\033[1;32m[✔] Tailscale is now offline.\033[0m"
    fi
    return 0
  }

  trap cleanup INT

  # Wait for URL
  while ! grep -q "https://" "$tmp_file" 2>/dev/null; do
    sleep 0.5
    if ! kill -0 $ts_pid 2>/dev/null; then
      echo -e "\033[31m[!] Error starting funnel.\033[0m"
      sudo cat "$tmp_file"
      return 1
    fi
  done

  local url=$(grep -o "https://[a-zA-Z0-9.-]*" "$tmp_file" | head -1)

  clear
  qrencode -t ansiutf8 "$url"
  echo -e "\n\033[1;32m[✔] Tunnel active: $url\033[0m"
  echo "Press CTRL+C to stop."

  tail -f "$tmp_file" 2>/dev/null
}
