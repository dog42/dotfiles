#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

prompt() {
  echo -e "\n$RED>>>$NC $*"
}

prompt "LET'S GO..."

pkg="arandr bat brave btop cmake curl dunst fastfetch fzf git jq kitty localsend npm nvim playerctl python3 sshfs tmux udiskie wl-clipboard wofi yazi zathura zathura-pdf-poppler zoxide zsh"

arch_pkg="battop bluetui downgrade elephant elephant-calc elephant-clipboard elephant-desktopapplications elephant-files elephant-providerlist elephant-runner elephant-symbols elephant-websearch hypridle hyprland hyprlock hyprmoncfg-bin hyprpaper hyprshot hyprshutdown impala qrencode seafile-client ttf-jetbrains-mono-nerd walker waybar wiremix xdg-desktop-portal-hyprland yay"

rm_pkg="hyprdynamicmonitors-bin"

{{ if eq .chezmoi.osRelease.id "arch" "cachyos" -}}

prompt "INSTALL NEW PKGs"
sudo pacman -Sy
for app in $arch_pkg $pkg; do
  (sudo pacman -S --noconfirm --needed $app >/dev/null && echo -e "${GREEN}INSTALL DONE PACMAN${NC} install $app") || (yay -S --noconfirm --needed $app >/dev/null && echo -e "${GREEN}INSTALL DONE YAY${NC} install $app") || echo -e "${RED}ERROR${NC} install $app"
done

prompt "REMOVE OLD PKGs"
for app in $rm_pkg; do
  (sudo pacman -Rns --noconfirm $app >/dev/null && echo -e "${GREEN}REMOVE DONE PACMAN${NC} remove $app") || (yay -Rns --noconfirm $app >/dev/null && echo -e "${GREEN}REMOVE DONE YAY${NC} remove $app") || echo -e "${RED}ERROR${NC} $app not installed"
done

{{ end -}}

