#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

prompt() {
  echo -e "\n$RED>>>$NC $*"
}

pkg="arandr bat btop cmake curl fzf git npm nvim python3 sshfs tmux udiskie yazi zsh"

arch_pkg=""
deb_pkg="1337 0815"

{{ if eq .chezmoi.osRelease.id "arch" -}}

prompt "ARCH BTW"
sudo pacman -Sy
for app in $pkg $arch_pkg; do
  (sudo pacman -S --noconfirm --needed $app >/dev/null && echo -e "${GREEN}DONE${NC} install $app") || echo -e "${RED}ERROR${NC} install $app"
done

{{ else if eq .chezmoi.osRelease.id "debian" -}}

prompt "DEBIAN"
sudo apt update
for app in $pkg $deb_pkg; do
  (sudo apt-get install -y $prog >/dev/null && echo -e "${GREEN}DONE${NC} install $prog") || echo -e "${RED}ERROR${NC} install $prog"
done

{{ end -}}

if [ -d "$HOME/.oh-my-zsh" ]; then
    prompt "Oh-My-Zsh is already installed"
else
    prompt "install Oh-My-Zsh"
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi
